# CiSandboxLite image — the basic instance_type caps container images at
# 4000MB and the shared ./Dockerfile is ~4373MB (postgres-16, JRE,
# build-essential, Go, trufflehog). Lite steps only run wrangler/pnpm/curl
# commands on a bare checkout (deploy, migrate, verify, rollback, watch),
# so this image carries just that toolchain.
FROM docker.io/cloudflare/sandbox:0.12.9@sha256:4a56a37a3cfd9b38d65bb4b5d0b341e6490a3a4c0226274ae4c1cca4948e85fe

RUN npm install -g pnpm@12.4.2 wrangler@4.133.0

# git for the fresh checkout; ca-certificates/curl for the https probes.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git curl \
 && rm -rf /var/lib/apt/lists/*

# Same Node floor as ./Dockerfile — repo deploy scripts run via pnpm/vp/tsx.
ARG NODE_VERSION=24.22.2
RUN ARCH="$(dpkg --print-architecture | sed 's/amd64/x64/;s/arm64/arm64/')" \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.gz" -o /tmp/node.tgz \
 && tar -C /usr/local --strip-components=1 -xzf /tmp/node.tgz \
 && rm /tmp/node.tgz \
 && node --version | grep -q "^v${NODE_VERSION}"
