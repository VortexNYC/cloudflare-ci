{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ci",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "vortex"
    }
  ],
  "containers": [
    {
      "class_name": "CiSandbox",
      "image": "./Dockerfile",
      "max_instances": 10,
      "instance_type": "standard-2"
    },
    {
      // Light pool for steps that don't install dependencies (e.g. D1
      // migrations): a quarter vCPU / 1 GiB is plenty for a wrangler CLI call.
      "class_name": "CiSandboxLite",
      "image": "./Dockerfile",
      "max_instances": 10,
      "instance_type": "basic"
    },
    {
      // Checks pool on sandbox-sdk 1.0 — each DO starts its own container.
      // New class alongside the 0.x pools: switching an existing class to
      // durable_object scheduling is a one-way deploy, so the checks path
      // gets its own. The `name` is required — a DO-scheduled app can't
      // reuse Wrangler's generated 0.x application name.
      "class_name": "ChecksSandbox",
      "name": "cloudflare-ci-checks-v1",
      "scheduling_policy": "durable_object",
      "images": {
        "checks": {
          "dockerfile": "./Dockerfile.checks"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "CiSandbox"
      },
      {
        "name": "SANDBOX_LITE",
        "class_name": "CiSandboxLite"
      },
      {
        "name": "CI_SCHEDULER",
        "class_name": "CiScheduler"
      },
      {
        "name": "CHECKS_SANDBOX",
        "class_name": "ChecksSandbox"
      }
    ]
  },
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": {
          "namespace": "vortex"
        },
        "targets": [
          {
            "type": "workflow",
            "workflow_name": "cloudflare-ci"
          }
        ]
      }
    ],
    "crons": ["*/15 * * * *"]
  },
  "workflows": [
    {
      "name": "cloudflare-ci",
      "binding": "CI_WORKFLOW",
      "class_name": "CI"
    },
    {
      "name": "cloudflare-ci-checks",
      "binding": "CHECKS_WORKFLOW",
      "class_name": "ChecksWorkflow"
    }
  ],
  "exports": {
    "CiSandbox": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CiSandboxLite": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CiScheduler": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ChecksSandbox": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "cloudflare-ci-backups"
    }
  ],
  "vars": {
    "BACKUP_BUCKET_NAME": "cloudflare-ci-backups",
    // Containers fetch restore archives over HTTP from this worker instead of
    // streaming through the DO isolate (which OOMs on large snapshots).
    "BACKUP_DOWNLOAD_BASE_URL": "https://cloudflare-ci.vortex-nyc.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "953346ce1b4f27fa04a76d83aeccab28"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
